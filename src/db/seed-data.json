  "community_posts": [
    { "id": "cp-001", "user_id": "seed-user-001", "medicine_id": 1, "title": "Dolo 650 vs Crocin — which works faster for fever?", "body": "I've been using Dolo 650 for years but recently my pharmacist suggested Crocin Advance instead. Has anyone noticed a difference in how fast they work?", "tags": ["fever", "paracetamol", "comparison"], "created_at": 1717200000 },
    { "id": "cp-002", "user_id": "seed-user-002", "medicine_id": 7, "title": "Glycomet GP 2 side effects — anyone experiencing nausea?", "body": "My doctor started me on Glycomet GP 2 for diabetes management. For the first week I've had persistent nausea after meals. Is this common? Does it go away?", "tags": ["diabetes", "metformin", "side-effects"], "created_at": 1717300000 },
    { "id": "cp-003", "user_id": "seed-user-003", "medicine_id": 9, "title": "When to take Thyronorm — before or after breakfast?", "body": "I've read conflicting advice online about whether to take Thyronorm on an empty stomach or with food. What does everyone here do?", "tags": ["thyroid", "timing", "advice"], "created_at": 1717400000 },
    { "id": "cp-004", "user_id": "seed-user-001", "medicine_id": 5, "title": "Pan-D long-term usage concerns", "body": "My gastroenterologist prescribed Pan-D for acid reflux. I've been on it for 3 months now. Are there any long-term risks I should discuss with my doctor?", "tags": ["antacid", "long-term", "acid-reflux"], "created_at": 1717500000 },
    { "id": "cp-005", "user_id": "seed-user-002", "medicine_id": 13, "title": "Montair LC for seasonal allergies — how long to continue?", "body": "Was prescribed Montair LC for seasonal allergies. The allergy season is almost over. Should I stop taking it or complete a full course?", "tags": ["allergy", "seasonal", "montelukast"], "created_at": 1717600000 },
    { "id": "cp-006", "user_id": "seed-user-003", "medicine_id": null, "title": "Generic medicines from Jan Aushadhi stores — are they effective?", "body": "I've been hearing a lot about Jan Aushadhi stores offering medicines at 50-80% cheaper prices. Has anyone tried them? Are they as effective as branded ones?", "tags": ["generic", "jan-aushadhi", "affordable"], "created_at": 1717700000 },
    { "id": "cp-007", "user_id": "seed-user-001", "medicine_id": 24, "title": "Atorva 10 and muscle pain — common side effect?", "body": "I've been taking Atorva 10 for cholesterol for 6 months. Recently noticing muscle aches in my legs. Has anyone else experienced this with statins?", "tags": ["cholesterol", "statin", "side-effects"], "created_at": 1717800000 },
    { "id": "cp-008", "user_id": "seed-user-002", "medicine_id": 25, "title": "Telma 40 — morning or night dose?", "body": "My cardiologist said I can take Telma 40 at any time of day. But I've read that taking BP medication at night may be better. Thoughts?", "tags": ["blood-pressure", "telmisartan", "timing"], "created_at": 1717900000 }
  ],
  "community_comments": [
    { "id": "cc-001", "post_id": "cp-001", "user_id": "seed-user-002", "body": "Both have the same active ingredient (paracetamol), so the effect should be similar. I personally prefer Dolo 650 because the higher dose works better for me.", "parent_comment_id": null, "created_at": 1717201000 },
    { "id": "cc-002", "post_id": "cp-001", "user_id": "seed-user-003", "body": "I agree with the above. Also check if you can get the generic paracetamol from Jan Aushadhi — same medicine at a fraction of the cost!", "parent_comment_id": "cc-001", "created_at": 1717202000 },
    { "id": "cc-003", "post_id": "cp-002", "user_id": "seed-user-001", "body": "Nausea is very common when starting metformin. Try taking it with food. It usually subsides after 2-3 weeks. If not, ask your doctor about the extended-release version.", "parent_comment_id": null, "created_at": 1717301000 },
    { "id": "cc-004", "post_id": "cp-003", "user_id": "seed-user-002", "body": "Always take Thyronorm on an empty stomach, at least 30 minutes before breakfast. This is the standard medical guidance for levothyroxine.", "parent_comment_id": null, "created_at": 1717401000 },
    { "id": "cc-005", "post_id": "cp-006", "user_id": "seed-user-001", "body": "I've been using Jan Aushadhi medicines for 2 years — paracetamol, metformin, and antacids. They work just as well. Huge savings!", "parent_comment_id": null, "created_at": 1717701000 },
    { "id": "cc-006", "post_id": "cp-006", "user_id": "seed-user-003", "body": "Generic medicines have the same active ingredient and are tested by CDSCO. The only difference is the brand name and packaging.", "parent_comment_id": "cc-005", "created_at": 1717702000 },
    { "id": "cc-007", "post_id": "cp-007", "user_id": "seed-user-003", "body": "Muscle pain can be a side effect of statins. Please mention this to your doctor — they may reduce the dose or switch your medication.", "parent_comment_id": null, "created_at": 1717801000 }
